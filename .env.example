# ============================================================
# Contoh konfigurasi. Copy file ini menjadi .env lalu isi nilainya.
# ============================================================

# --- Ollama (lokal) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-coder

# --- OpenAI-compatible ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Provider lain (placeholder) ---
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# GEMINI_MODEL=

# --- Context budget / capability ---
# Batas token untuk KONTEKS PENGETAHUAN (Project Bible). Terpisah dari anggaran
# percakapan: context window provider adalah anggaran seluruh percakapan,
# sehingga Bible dibatasi pada porsinya. 0 = tanpa batas tambahan.
CONTEXT_KNOWLEDGE_MAX_TOKENS=8000

# Anggaran PERCAKAPAN (fallback global) bila provider TIDAK melaporkan
# capability context window-nya. Provider cloud memakai nilai global ini.
CONTEXT_MAX_TOKENS=16000

# --- Context window per provider (capability nyata model) ---
# Isi sesuai context window model yang BENAR-BENAR dipakai. AETHER memakai
# nilai ini untuk menurunkan anggaran percakapan (context window - reserve),
# sehingga model dengan context window besar tidak dipaksa turun ke
# CONTEXT_MAX_TOKENS. Biarkan 0 bila tidak diketahui (perilaku lama).
# Lihat sumber resmi provider untuk angka yang benar; jangan menebak.
# DEEPSEEK_CONTEXT_WINDOW=64000
# OPENROUTER_CONTEXT_WINDOW=64000
# OPENAI_CONTEXT_WINDOW=128000

# --- Provider default ---
DEFAULT_PROVIDER=ollama
